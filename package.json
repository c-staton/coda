{
  "name": "coda",
  "version": "0.1.1",
  "description": "Highlight text on your Mac and hear it read aloud.",
  "type": "module",
  "bin": {
    "coda": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./digest": "./src/digest.mjs",
    "./tts": "./src/tts.mjs",
    "./state": "./src/state.mjs"
  },
  "scripts": {
    "test": "node --test",
    "coda": "node src/cli.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "apps/macos",
    "scripts",
    "install",
    "uninstall",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c-staton/coda.git"
  },
  "bugs": {
    "url": "https://github.com/c-staton/coda/issues"
  },
  "homepage": "https://github.com/c-staton/coda#readme",
  "keywords": [
    "tts",
    "text-to-speech",
    "macos",
    "accessibility",
    "grok"
  ],
  "license": "MIT"
}
